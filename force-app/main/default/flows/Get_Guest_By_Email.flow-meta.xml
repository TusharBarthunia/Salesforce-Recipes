<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Looks up a Palonia guest by email and returns their latest active reservation dates.</description>
    <environments>Default</environments>
    <interviewLabel>Get Guest By Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Guest By Email</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Guest</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <assignments>
        <name>Set_Guest_Not_Found_Error</name>
        <label>Set Guest Not Found Error</label>
        <locationX>440</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No guest was found for the supplied email address.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Guest_Details</name>
        <label>Assign Guest Details</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>GuestId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Guest.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>GuestName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Guest.Preferred_Name__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Active_Reservation</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Reservation_Not_Found_Error</name>
        <label>Set Reservation Not Found Error</label>
        <locationX>440</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No booked or checked-in reservation was found for this guest.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Reservation_Details</name>
        <label>Assign Reservation Details</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>CheckInDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formCheckInDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CheckOutDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formCheckOutDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Guest_Found</name>
        <label>Guest Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Set_Guest_Not_Found_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Guest Not Found</defaultConnectorLabel>
        <rules>
            <name>Guest_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Guest.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Guest_Details</targetReference>
            </connector>
            <label>Guest Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reservation_Found</name>
        <label>Reservation Found?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Set_Reservation_Not_Found_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Reservation Not Found</defaultConnectorLabel>
        <rules>
            <name>Reservation_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Reservation.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Reservation_Details</targetReference>
            </connector>
            <label>Reservation Exists</label>
        </rules>
    </decisions>
    <formulas>
        <name>formCheckInDate</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Active_Reservation.Check_In_Date__c})</expression>
    </formulas>
    <formulas>
        <name>formCheckOutDate</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Active_Reservation.Check_Out_Date__c})</expression>
    </formulas>
    <recordLookups>
        <name>Get_Guest</name>
        <label>Get Guest</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Guest_Found</targetReference>
        </connector>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Guest__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Preferred_Name__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Active_Reservation</name>
        <label>Get Active Reservation</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Reservation_Found</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Guest__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Checked In</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Booked</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Reservation__c</object>
        <queriedFields>Check_In_Date__c</queriedFields>
        <queriedFields>Check_Out_Date__c</queriedFields>
        <sortField>Check_In_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <variables>
        <name>Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>GuestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>GuestName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>CheckInDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>CheckOutDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>