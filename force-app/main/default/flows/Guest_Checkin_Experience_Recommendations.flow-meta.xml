<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Generate a personalized welcome email for the guest.</description>
        <name>Generate_Welcome_Email</name>
        <label>Generate Welcome Email</label>
        <locationX>176</locationX>
        <locationY>854</locationY>
        <actionName>Palonia_Welcome_Email</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Save_Welcome_Email_Draft</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:Guest_Name</name>
            <value>
                <elementReference>formGuestDisplayName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Check_In_Date</name>
            <value>
                <elementReference>formCheckInDateText</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Check_Out_Date</name>
            <value>
                <elementReference>formCheckOutDateText</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Relevant_Experiences</name>
            <value>
                <elementReference>varPromptExperiences</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Palonia_Welcome_Email</nameSegment>
        <outputParameters>
            <assignToReference>varWelcomeEmail</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
        <offset>0</offset>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <description>Fires when a Reservation Status changes to Checked In. Looks up the related Guest, finds Experiences whose Type matches any of the guest three interests, creates a concierge Task, generates a personalized welcome email, and saves it to the reservation.</description>
    <interviewLabel>Guest_Checkin_Experience_Recommendations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Guest Check-In Experience Recommendations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Guest</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Checked In</stringValue>
            </value>
        </filters>
        <object>Reservation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>

    <!-- ── Assignments (grouped) ──────────────────────────────────────────────── -->

    <assignments>
        <name>Init_Task_Body</name>
        <label>Initialize Summary</label>
        <locationX>176</locationX>
        <locationY>494</locationY>
        <assignmentItems>
            <assignToReference>varTaskBody</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>tmplHeader</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Experiences</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Append_Line</name>
        <label>Append Experience Line</label>
        <locationX>440</locationX>
        <locationY>614</locationY>
        <assignmentItems>
            <assignToReference>varTaskBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tmplLineItem</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPromptExperiences</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tmplPromptExperience</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Experiences</targetReference>
        </connector>
    </assignments>

    <!-- ── Decisions ──────────────────────────────────────────────────────────── -->

    <decisions>
        <name>Guest_Found</name>
        <label>Guest Found?</label>
        <locationX>308</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>No Guest — Skip</defaultConnectorLabel>
        <rules>
            <name>Has_Guest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Guest</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Matching_Experiences</targetReference>
            </connector>
            <label>Has Guest</label>
        </rules>
    </decisions>

    <decisions>
        <name>Has_Matches</name>
        <label>Has Matching Experiences?</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <defaultConnectorLabel>No Matches — Skip Task</defaultConnectorLabel>
        <rules>
            <name>Experiences_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Experiences</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Init_Task_Body</targetReference>
            </connector>
            <label>Experiences Found</label>
        </rules>
    </decisions>

    <!-- ── Formulas (grouped) ─────────────────────────────────────────────────── -->

    <!-- Prefer Preferred_Name__c; fall back to Full_Name__c -->
    <formulas>
        <name>formGuestDisplayName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Guest.Preferred_Name__c}), {!Get_Guest.Full_Name__c}, {!Get_Guest.Preferred_Name__c})</expression>
    </formulas>

    <formulas>
        <name>formTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Experience Recommendations for " &amp; {!formGuestDisplayName}</expression>
    </formulas>

    <formulas>
        <name>formToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>

    <formulas>
        <name>formCheckInDateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Check_In_Date__c})</expression>
    </formulas>

    <formulas>
        <name>formCheckOutDateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Check_Out_Date__c})</expression>
    </formulas>

    <!-- ── Loops ──────────────────────────────────────────────────────────────── -->

    <loops>
        <name>Loop_Experiences</name>
        <label>Loop Experiences</label>
        <locationX>176</locationX>
        <locationY>614</locationY>
        <collectionReference>Get_Matching_Experiences</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Task</targetReference>
        </noMoreValuesConnector>
    </loops>

    <!-- ── Record Creates ─────────────────────────────────────────────────────── -->

    <recordCreates>
        <name>Create_Task</name>
        <label>Create Recommendation Task</label>
        <locationX>176</locationX>
        <locationY>734</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>formToday</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>varTaskBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <connector>
            <targetReference>Generate_Welcome_Email</targetReference>
        </connector>
        <object>Task</object>
    </recordCreates>

    <recordUpdates>
        <name>Save_Welcome_Email_Draft</name>
        <label>Save Welcome Email Draft</label>
        <locationX>176</locationX>
        <locationY>974</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Welcome_Email_Draft__c</field>
            <value>
                <elementReference>varWelcomeEmail</elementReference>
            </value>
        </inputAssignments>
        <object>Reservation__c</object>
    </recordUpdates>

    <!-- ── Record Lookups (grouped) ───────────────────────────────────────────── -->

    <recordLookups>
        <name>Get_Guest</name>
        <label>Get Guest</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Guest_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Guest__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Guest__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Full_Name__c</queriedFields>
        <queriedFields>Preferred_Name__c</queriedFields>
        <queriedFields>Interest_1__c</queriedFields>
        <queriedFields>Interest_2__c</queriedFields>
        <queriedFields>Interest_3__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <name>Get_Matching_Experiences</name>
        <label>Get Matching Experiences</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Matches</targetReference>
        </connector>
        <filterLogic>1 OR 2 OR 3</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_1__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_2__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_3__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Experience__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Type__c</queriedFields>
        <queriedFields>Price__c</queriedFields>
        <queriedFields>Duration_Hours__c</queriedFields>
        <queriedFields>Location__c</queriedFields>
        <queriedFields>Description__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- ── Text Templates (grouped) ───────────────────────────────────────────── -->

    <!-- Opening header line; references formGuestDisplayName formula -->
    <textTemplates>
        <name>tmplHeader</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Recommended experiences for {!formGuestDisplayName} based on their interests:
</text>
    </textTemplates>

    <textTemplates>
        <name>tmplPromptExperience</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Experience: {!Loop_Experiences.Name}
Description: {!Loop_Experiences.Description__c}

</text>
    </textTemplates>

    <!-- One bullet line per loop iteration; references the current Experience record -->
    <textTemplates>
        <name>tmplLineItem</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>• {!Loop_Experiences.Name} — ${!Loop_Experiences.Price__c} | {!Loop_Experiences.Duration_Hours__c} hrs | {!Loop_Experiences.Location__c}
</text>
    </textTemplates>

    <!-- ── Variables ──────────────────────────────────────────────────────────── -->

    <variables>
        <name>varTaskBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>varPromptExperiences</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>varWelcomeEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
