<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Finds available scheduled sessions for the guest's interests and returns formatted experience details.</description>
    <environments>Default</environments>
    <interviewLabel>Get Guest Available Experiences {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Guest Available Experiences</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Guest</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <assignments>
        <name>Collect_Experience_Id</name>
        <label>Collect Experience Id</label>
        <locationX>440</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varExperienceIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Interested_Experiences.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Interested_Experiences</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Append_Session_Summary</name>
        <label>Append Session Summary</label>
        <locationX>440</locationX>
        <locationY>960</locationY>
        <assignmentItems>
            <assignToReference>varAvailableExperiencesSummary</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>tmplExperienceSummary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Available_Sessions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Empty_Summary</name>
        <label>Set Empty Summary</label>
        <locationX>176</locationX>
        <locationY>1080</locationY>
        <assignmentItems>
            <assignToReference>AvailableExperiencesSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formFinalSummary</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <formulas>
        <name>formCheckInDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!CheckInDate})</expression>
    </formulas>
    <formulas>
        <name>formCheckOutDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!CheckOutDate})</expression>
    </formulas>
    <formulas>
        <name>formFinalSummary</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varAvailableExperiencesSummary}), "No matching experiences are scheduled during this stay.", {!varAvailableExperiencesSummary})</expression>
    </formulas>
    <loops>
        <name>Loop_Interested_Experiences</name>
        <label>Loop Interested Experiences</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Interested_Experiences</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collect_Experience_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Available_Sessions</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Available_Sessions</name>
        <label>Loop Available Sessions</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <collectionReference>Get_Available_Sessions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Session_Experience</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Empty_Summary</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordLookups>
        <name>Get_Guest</name>
        <label>Get Guest</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Interested_Experiences</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GuestId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Guest__c</object>
        <queriedFields>Interest_1__c</queriedFields>
        <queriedFields>Interest_2__c</queriedFields>
        <queriedFields>Interest_3__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Interested_Experiences</name>
        <label>Get Interested Experiences</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Interested_Experiences</targetReference>
        </connector>
        <filterLogic>1 OR 2 OR 3</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_1__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_2__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Guest.Interest_3__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Experience__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Available_Sessions</name>
        <label>Get Available Sessions</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Available_Sessions</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>Experience__c</field>
            <operator>In</operator>
            <value>
                <elementReference>varExperienceIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Canceled__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>formCheckInDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>formCheckOutDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Experience_Session__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Experience__c</queriedFields>
        <queriedFields>Date__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Session_Experience</name>
        <label>Get Session Experience</label>
        <locationX>440</locationX>
        <locationY>840</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Append_Session_Summary</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Available_Sessions.Experience__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Experience__c</object>
        <queriedFields>Name</queriedFields>
        <queriedFields>Type__c</queriedFields>
        <queriedFields>Description__c</queriedFields>
        <queriedFields>Location__c</queriedFields>
        <queriedFields>Price__c</queriedFields>
        <queriedFields>Duration_Hours__c</queriedFields>
        <queriedFields>Activity_Level__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <textTemplates>
        <name>tmplExperienceSummary</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Experience session ID: {!Loop_Available_Sessions.Id}
Experience: {!Get_Session_Experience.Name}
Type: {!Get_Session_Experience.Type__c}
Date: {!Loop_Available_Sessions.Date__c}
Location: {!Get_Session_Experience.Location__c}
Price: {!Get_Session_Experience.Price__c}
Duration (hours): {!Get_Session_Experience.Duration_Hours__c}
Activity level: {!Get_Session_Experience.Activity_Level__c}
Description: {!Get_Session_Experience.Description__c}

</text>
    </textTemplates>
    <variables>
        <name>GuestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>CheckInDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>CheckOutDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varExperienceIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAvailableExperiencesSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>AvailableExperiencesSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>