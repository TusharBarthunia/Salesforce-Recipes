<?xml version="1.0" encoding="utf-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Creates a one-guest booking for a selected experience session and returns a confirmation.</description>
    <environments>Default</environments>
    <interviewLabel>Create Experience Booking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Experience Booking</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Session</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <assignments>
        <name>Set_Confirmation</name>
        <label>Set Booking Confirmation</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>Confirmation</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formConfirmation</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <formulas>
        <name>formConfirmation</name>
        <dataType>String</dataType>
        <expression>"Your booking for " &amp; {!Get_Experience.Name} &amp; " on " &amp; TEXT({!Get_Session.Date__c}) &amp; " is confirmed for one guest."</expression>
    </formulas>
    <recordCreates>
        <name>Create_Booking</name>
        <label>Create Experience Booking</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Experience_Session__c</field>
            <value>
                <elementReference>Get_Session.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Guest__c</field>
            <value>
                <elementReference>GuestId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Number_of_Guests__c</field>
            <value>
                <numberValue>1</numberValue>
            </value>
        </inputAssignments>
        <object>Experience_Booking__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Set_Confirmation</targetReference>
        </connector>
    </recordCreates>
    <recordLookups>
        <name>Get_Session</name>
        <label>Get Session</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Experience</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ExperienceSessionId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Experience_Session__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Date__c</queriedFields>
        <queriedFields>Experience__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Experience</name>
        <label>Get Experience</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Booking</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Session.Experience__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Experience__c</object>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <variables>
        <name>GuestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>ExperienceSessionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Confirmation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>